#version 450

/* built in:
in uvec3 gl_NumWorkGroups;
in uvec3 gl_WorkGroupID;
in uvec3 gl_LocalInvocationID;
in uvec3 gl_GlobalInvocationID;
in uint  gl_LocalInvocationIndex;
*/

layout( local_size_x_id = 0) in;
layout( local_size_y_id = 1) in;

layout(binding = 0) buffer inputBuf {int v1[];};
layout(binding = 1) buffer outBuf {int v2[];};

// Push constant

layout(push_constant) uniform PushStruct {
    uint w;    // Array size
    uint h;    // Array size
} p;


shared int[(gl_WorkGroupSize.x + 1) * gl_WorkGroupSize.y] shared_ints;

void main() {
    // global IDs
    uint gIDx = gl_GlobalInvocationID.x;
    uint gIDy = gl_GlobalInvocationID.y;
    // work group sizes
    uint lSizeX = gl_WorkGroupSize.x;
    uint lSizeY = gl_WorkGroupSize.y;
    uint stride = lSizeX + 1;
    //  local IDs
    uint lIDx = gl_LocalInvocationID.x;
    uint lIDy = gl_LocalInvocationID.y;

    if (gIDx < p.w && gIDy < p.h)
        shared_ints[lIDy * stride + lIDx] = v1[gIDy * p.w + gIDx];

    barrier();

    uint i = gl_LocalInvocationIndex;
    uint r = i / lSizeY;
    uint c = i % lSizeY;

    uint outRow = gl_WorkGroupID.x * lSizeX + r;
    uint ly = lSizeY - 1 - c;
    uint inY = gl_WorkGroupID.y * lSizeY + ly;

    if (outRow < p.w && inY < p.h) {
        uint outCol = p.h - 1 - inY;
        v2[outRow * p.h + outCol] = shared_ints[ly * stride + r];
    }
}